# Local native development uses SQLite automatically. Optional overrides:
RANKDLAB_ENVIRONMENT=development
RANKDLAB_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]
RANKDLAB_HOSTS=["127.0.0.1","localhost"]
RANKDLAB_SECURE_COOKIES=false
RANKDLAB_MAX_UPLOAD_MB=20
RANKDLAB_PARSER_TIMEOUT=90

# Docker Compose requires a new random local DB password; no default credential.
# Use URL-safe characters so this value is valid in the connection URL.
RANKDLAB_DB_PASSWORD=

# Compose local browser origin. Use HTTPS + secure cookies + explicit public host
# in a reviewed production configuration. Never expose this development example.
RANKDLAB_WEB_ORIGIN=http://127.0.0.1:8080
